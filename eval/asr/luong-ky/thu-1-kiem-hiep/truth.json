[
 {
  "id": 1,
  "start": 15.1,
  "end": 19.98,
  "text": "师父，山下的李家庄出事了，昨夜一共失踪了七个人。",
  "note": "nhạc nền SNR~4dB"
 },
 {
  "id": 2,
  "start": 20.58,
  "end": 25.3,
  "text": "慌什么？先把玄天剑拿来，再去请慕容雪姑娘。",
  "note": "nhạc nền SNR~4dB"
 },
 {
  "id": 3,
  "start": 25.9,
  "end": 30.38,
  "text": "我早就来了。你们说的那个黑衣人，我在破庙里见过一次。",
  "note": "nhạc nền SNR~4dB"
 },
 {
  "id": 4,
  "start": 30.98,
  "end": 35.14,
  "text": "破庙？就是城西那座已经荒废了三十多年的观音庙吗？",
  "note": "nhạc nền SNR~4dB"
 },
 {
  "id": 5,
  "start": 35.94,
  "end": 38.82,
  "text": "嘘，小声点，外面有人在听。",
  "note": "thì thầm, nhỏ hơn ~18 dB"
 },
 {
  "id": 6,
  "start": 41.82,
  "end": 46.86,
  "text": "雨这么大，他们走不远的，今晚子时我们就动手。",
  "note": "mưa to + sấm đè lên câu"
 },
 {
  "id": 7,
  "start": 49.16,
  "end": 52.52,
  "text": "站住！交出那本天机秘录，饶你们不死！",
  "note": "đánh nhau, nổ, SNR~0dB"
 },
 {
  "id": 8,
  "start": 52.82,
  "end": 54.38,
  "text": "师妹小心左边，他的暗器上有毒！",
  "note": "nói nhanh x1.45 + nổ"
 },
 {
  "id": 9,
  "start": 54.58,
  "end": 57.05,
  "text": "别管我，快带师父从后门走，我来挡住他们！",
  "note": "nói nhanh x1.45 + nổ"
 },
 {
  "id": 10,
  "start": 57.55,
  "end": 60.35,
  "text": "哈哈哈，今天谁也别想离开这里。",
  "note": "cười + trống"
 },
 {
  "id": 11,
  "start": 87.85,
  "end": 95.37,
  "text": "喂，是王掌柜吗？我们欠你的三百七十二两银子，下个月初八一定还清。",
  "note": "qua điện thoại, số tiền, tên riêng"
 },
 {
  "id": 12,
  "start": 95.77,
  "end": 100.89,
  "text": "OK，没问题，不过这次的利息要按百分之五算。",
  "note": "điện thoại, chen tiếng Anh, giọng nữ Anh"
 },
 {
  "id": 13,
  "start": 101.89,
  "end": 105.91,
  "text": "这个山洞里怎么会有回声？好像有人在里面说话。",
  "note": "vang hang động"
 },
 {
  "id": 14,
  "start": 106.41,
  "end": 111.39,
  "text": "莫要再往前走了，那下面全是机关，掉下去就上不来了。",
  "note": "vang + giọng Tứ Xuyên"
 },
 {
  "id": 15,
  "start": 112.69,
  "end": 115.33,
  "text": "你到底是谁？为什么一直跟着我们？",
  "note": "hai người nói chồng"
 },
 {
  "id": 16,
  "start": 114.33,
  "end": 118.73,
  "text": "等等，先别动手，他可能知道真相。",
  "note": "chồng lên câu trước 1 giây"
 },
 {
  "id": 17,
  "start": 121.73,
  "end": 124.53,
  "text": "二十年前，你的父亲就是在这里被人害死的。",
  "note": "bài hát to đè lời, SNR~-2dB"
 },
 {
  "id": 18,
  "start": 125.13,
  "end": 128.09,
  "text": "原来如此，那我一定要为他报仇。",
  "note": "bài hát to đè lời, SNR~-2dB"
 }
]