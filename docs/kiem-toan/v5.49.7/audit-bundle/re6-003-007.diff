diff --git a/scripts/re6-005-live-measure.test.mjs b/scripts/re6-005-live-measure.test.mjs
new file mode 100644
index 0000000..92e558d
--- /dev/null
+++ b/scripts/re6-005-live-measure.test.mjs
@@ -0,0 +1,124 @@
+/**
+ * RE6-005: đo Dịch trực tiếp với cầu nối giả (ws trên loopback). Kiểm đồng hồ monotonic, dọn bộ đếm khi đóng sớm,
+ * lượt lỗi/thiếu mốc tách khỏi phân vị, P50/95/99. Corpus đa ngôn ngữ cho bộ lọc chữ sót (delta = final, tên riêng).
+ */
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { WebSocketServer } from "ws";
+import { measure, pct, speechSpan, summarize } from "../deploy/vps/do-live/live-measure.ts";
+import { dropLeftoverScript } from "../src/lib/live/leftover-script.ts";
+
+function tone(ms, startMs = 500, endMs = ms - 500) {
+  const pcm = Buffer.alloc((ms / 1000) * 32000);
+  for (let i = 0; i < pcm.length / 2; i++) {
+    const t = (i / 16000) * 1000;
+    pcm.writeInt16LE(t >= startMs && t < endMs ? Math.round(8000 * Math.sin(i / 3)) : 0, i * 2);
+  }
+  return pcm;
+}
+
+async function bridge(behaviour) {
+  const wss = new WebSocketServer({ port: 0, host: "127.0.0.1" });
+  const got = { frames: 0, afterStop: 0 };
+  wss.on("connection", (ws) => {
+    let stopped = false;
+    ws.send(JSON.stringify({ type: "ready" }));
+    ws.on("message", (d, bin) => {
+      if (bin) { got.frames++; if (stopped) got.afterStop++; return; }
+      if (JSON.parse(d.toString()).type === "stop") {
+        stopped = true;
+        ws.send(JSON.stringify({ type: "event", event: { kind: "translation", final: true, text: "x" } }));
+        ws.close(1000);
+      }
+    });
+    behaviour(ws, got);
+  });
+  await new Promise((r) => wss.on("listening", r));
+  return { url: `ws://127.0.0.1:${wss.address().port}/live`, got, close: () => new Promise((r) => wss.close(r)) };
+}
+
+test("RE6-005: phân vị dùng cách làm tròn lên, không trả -Infinity khi rỗng", () => {
+  assert.equal(pct([], 50), null);
+  const xs = Array.from({ length: 100 }, (_, i) => i + 1);
+  assert.deepEqual([pct(xs, 50), pct(xs, 95), pct(xs, 99)], [50, 95, 99]);
+  assert.equal(speechSpan(Buffer.alloc(32000)), null, "đoạn im lặng không bịa mốc tiếng nói");
+});
+
+test("RE6-005: lượt đủ mốc đo theo đồng hồ monotonic, tính từ lúc bắt đầu có tiếng", async () => {
+  const b = await bridge((ws) => {
+    setTimeout(() => ws.send(JSON.stringify({ type: "event", event: { kind: "source-delta" } })), 40);
+    setTimeout(() => ws.send(JSON.stringify({ type: "event", event: { kind: "translation-delta" } })), 80);
+  });
+  let fake = 1_000_000; // đồng hồ giả chỉ tăng, độc lập Date.now
+  const r = await measure({ url: b.url, lang: "zh", pcm: tone(1000, 100, 900), frameMs: 20, now: () => (fake += 1) });
+  await b.close();
+  assert.equal(r.ok, true, JSON.stringify(r));
+  assert.equal(r.onsetMs, 100);
+  assert.ok(r.firstSource_s != null && r.finals === 1);
+});
+
+test("RE6-005: cầu nối đóng sớm → dừng bộ đếm, không gửi khung sau khi đóng, lượt bị đếm là lỗi riêng", async () => {
+  const b = await bridge((ws) => setTimeout(() => ws.close(1011, "boom"), 60));
+  const r = await measure({ url: b.url, lang: "ja", pcm: tone(3000), frameMs: 10 });
+  const framesAtClose = b.got.frames;
+  await new Promise((res) => setTimeout(res, 200));
+  await b.close();
+  assert.equal(r.ok, false);
+  assert.equal(r.why, "dong-1011");
+  assert.equal(b.got.frames, framesAtClose, "không còn khung nào sau khi đóng");
+  assert.equal(r.framesAfterClose, 0);
+  const s = summarize([r]);
+  assert.deepEqual(s.failed, { "dong-1011": 1 });
+  assert.equal(s.onsetToSourceReceive_s.n, 0);
+  assert.equal(s.onsetToSourceReceive_s.p99, null);
+});
+
+test("RE6-005: hết giờ → terminate, dọn bộ đếm, lượt het-gio", async () => {
+  const b = await bridge(() => {});
+  const r = await measure({ url: b.url, lang: "ko", pcm: tone(30000), frameMs: 10, timeoutMs: 150 });
+  const n = b.got.frames;
+  await new Promise((res) => setTimeout(res, 150));
+  await b.close();
+  assert.equal(r.why, "het-gio");
+  assert.equal(b.got.frames, n);
+});
+
+test("RE6-005: summarize tách lỗi/thiếu mốc khỏi phân vị và có P50/P95/P99", () => {
+  const base = { connectMs: 1, onsetMs: 0, offsetMs: 0, finals: 1, framesAfterClose: 0, errors: [], usage: null, why: "dong-1000" };
+  const rows = [
+    ...Array.from({ length: 20 }, (_, i) => ({ ...base, lang: "zh", ok: true, firstSource_s: (i + 1) / 10, firstTranslation_s: 1, lastFinalAfterSpeechEnd_s: 2 })),
+    { ...base, lang: "en", ok: false, firstSource_s: null, firstTranslation_s: null, lastFinalAfterSpeechEnd_s: null },
+    { ...base, lang: "en", ok: false, firstSource_s: 0.1, firstTranslation_s: 0.2, lastFinalAfterSpeechEnd_s: null, finals: 0 },
+    { ...base, lang: "en", ok: false, firstSource_s: 9, firstTranslation_s: 9, lastFinalAfterSpeechEnd_s: 9, errors: ["x"] },
+  ];
+  const s = summarize(rows);
+  assert.equal(s.samples, 23); assert.equal(s.ok, 20);
+  assert.deepEqual(s.failed, { "thieu-chu-goc": 1, "thieu-cau-chot": 1, loi: 1 });
+  assert.deepEqual(s.onsetToSourceReceive_s, { n: 20, p50: 1, p95: 1.9, p99: 2, max: 2 });
+  assert.match(s.note, /chưa gồm thời gian vẽ/);
+});
+
+// Corpus đa ngôn ngữ: (đích, câu chốt từ model, các mẩu delta, kỳ vọng).
+const CORPUS = [
+  ["vi", "Anh Nguyễn Văn An đến Hà Nội năm 2026.", ["Anh Nguyễn ", "Văn An đến ", "Hà Nội năm 2026."], "Anh Nguyễn Văn An đến Hà Nội năm 2026."],
+  ["vi", "Bạn phải luôn如一.", ["Bạn phải ", "luôn如", "一."], "Bạn phải luôn."],
+  ["en", "Mr. Müller met Sørensen in Zürich.", ["Mr. Müller ", "met Sørensen ", "in Zürich."], "Mr. Müller met Sørensen in Zürich."],
+  ["en", "Привет, Иван! Hello, Yusuf — مرحبا.", ["Привет, Иван! ", "Hello, Yusuf — مرحبا."], "Привет, Иван! Hello, Yusuf — مرحبا."],
+  ["vi", "Cô ấy nói สวัสดี với tôi.", ["Cô ấy nói ", "สวัสดี với tôi."], "Cô ấy nói สวัสดี với tôi."],
+  ["vi", "Tôi gặp Tanaka-san ở Tokyo。", ["Tôi gặp Tanaka-san ", "ở Tokyo。"], "Tôi gặp Tanaka-san ở Tokyo."],
+  ["ja", "田中さんは東京に行きました。", ["田中さんは", "東京に行きました。"], "田中さんは東京に行きました。"],
+];
+
+test("RE6-005: corpus đa ngôn ngữ — chữ Latin/Cyrillic/Ả Rập/Thái và tên riêng phiên âm không bị mất; delta khớp final", () => {
+  for (const [target, final, deltas, want] of CORPUS) {
+    assert.equal(dropLeftoverScript(final, target), want, final);
+    const joined = deltas.map((d) => dropLeftoverScript(d, target, false)).join("");
+    assert.equal(dropLeftoverScript(joined, target), want, `delta ${final}`);
+  }
+});
+
+test("RE6-005: GIỚI HẠN ĐÃ BIẾT — tên riêng viết bằng chữ Hán/kana/Hangul trong bản dịch tiếng Việt bị bỏ", () => {
+  // Ghi lại hành vi hiện tại để Chủ quyết chính sách; không tự đổi đầu ra khách hàng.
+  assert.equal(dropLeftoverScript("Tôi gặp 王小明 hôm qua.", "vi"), "Tôi gặp hôm qua.");
+  assert.equal(dropLeftoverScript("Ca sĩ 아이유 hát.", "vi"), "Ca sĩ hát.");
+});
diff --git a/scripts/re6-007-admission-pg.test.mjs b/scripts/re6-007-admission-pg.test.mjs
new file mode 100644
index 0000000..8e29f3f
--- /dev/null
+++ b/scripts/re6-007-admission-pg.test.mjs
@@ -0,0 +1,172 @@
+/**
+ * RE6-007: tyzo_admit (0057) trên PostgreSQL thật riêng (TYZO_TEST_PG_URL, CSDL đã chạy migrate). Dữ liệu tổng hợp.
+ * Đúng đắn: 1k/5k khách chờ, ký tự lạ trong khóa JSON, điều kiện được xét, trần dùng chung, phần dành cho live,
+ * burst 300 không vượt trần. Đo: độ trễ theo số khách chờ, đồng thời 25/50/100/200, burst 300.
+ * RE6_BENCH_OUT=<tệp> để ghi kết quả đo dạng JSON.
+ */
+import assert from "node:assert/strict";
+import { writeFileSync } from "node:fs";
+import { after, before, beforeEach, test } from "node:test";
+import pg from "pg";
+
+const URL_ = process.env.TYZO_TEST_PG_URL;
+const pgTest = URL_ ? test : test.skip;
+const DEF = { enabled: true, batch: 48, modal: 8, live: 48, perUser: 2, perUserModal: 3, perProvider: 40, perModel: 24, liveReserve: 0 };
+let pool;
+const bench = {};
+before(() => { if (URL_) pool = new pg.Pool({ connectionString: URL_, max: 320 }); });
+after(async () => {
+  if (process.env.RE6_BENCH_OUT && Object.keys(bench).length) writeFileSync(process.env.RE6_BENCH_OUT, JSON.stringify(bench, null, 1));
+  await pool?.end();
+});
+const q = (text, values) => pool.query(text, values);
+beforeEach(async () => {
+  if (!pool) return;
+  await q("delete from work_admissions"); await q("delete from run_async_asr_jobs"); await q("delete from work_waiters");
+  await q("delete from room_settings where key = 'work_admission'");
+});
+const limits = (v) => q(`insert into room_settings (key, value) values ('work_admission', $1)
+  on conflict (key) do update set value = excluded.value`, [JSON.stringify({ ...DEF, ...v })]);
+let seq = 0;
+async function admit(user, provider, model, lane, client = pool) {
+  const id = `a${++seq}`;
+  const t = performance.now();
+  const r = (await client.query("select tyzo_admit($1,$2,$3,$4,$5,$6::jsonb,60,null) r", [id, user, provider, model, lane, JSON.stringify(DEF)])).rows[0].r;
+  return { ok: r === id, r, ms: performance.now() - t };
+}
+/** Khách chờ: eligible = đã chờ ≥ 3 s và còn hiện diện; stale = bỏ đi quá 6 s; fresh = mới chờ < 3 s. */
+async function seedWaiters(n, { kind = "eligible", provider = "p2", model = "m2", lane = "batch", prefix = "w" } = {}) {
+  const since = kind === "fresh" ? "clock_timestamp()" : "clock_timestamp() - interval '20 seconds'";
+  const seen = kind === "stale" ? "clock_timestamp() - interval '10 seconds'" : "clock_timestamp()";
+  await q(`insert into work_waiters (user_id, provider, model, lane, since, seen_at)
+    select $1 || g, $2, $3, $4, ${since} + g * interval '1 microsecond', ${seen} from generate_series(1, $5) g`, [prefix, provider, model, lane, n]);
+}
+async function running(provider, model, lane, n, prefix = "r") {
+  await q(`insert into work_admissions (id, user_id, provider, model, lane) select $1 || g, $1 || g, $2, $3, $4 from generate_series(1, $5) g`, [prefix + provider + lane, provider, model, lane, n]);
+}
+const pct = (xs, p) => { const s = [...xs].sort((a, b) => a - b); return s.length ? +s[Math.min(s.length - 1, Math.ceil((p / 100) * s.length) - 1)].toFixed(2) : null; };
+const dist = (xs) => ({ n: xs.length, p50: pct(xs, 50), p95: pct(xs, 95), p99: pct(xs, 99), max: pct(xs, 100) });
+
+pgTest("RE6-007: ký tự lạ trong mã khách/nhà/model không làm lẫn khóa JSON", async () => {
+  await limits({ perUser: 1 });
+  const odd = ['u1","batch', 'u1', 'a\\"b', "[]", "{,}", "Nguyễn\u0000x".replace("\u0000", ""), "😀", " ", "a'b;--"];
+  for (const u of odd) assert.equal((await admit(u, 'p"[1]', 'm,"x', "batch")).ok, true, `lượt đầu ${JSON.stringify(u)}`);
+  for (const u of odd) assert.equal((await admit(u, 'p"[1]', 'm,"x', "batch")).r, "busy", `suất riêng ${JSON.stringify(u)}`);
+  // Nhà/model khác nhau chỉ ở dấu nháy và phẩy: trần model đếm riêng.
+  await limits({ perUser: 5, perModel: 1 });
+  assert.equal((await admit("x1", "p", 'a","b', "batch")).ok, true);
+  assert.equal((await admit("x2", 'p","a', "b", "batch")).ok, true);
+  assert.equal((await admit("x3", "p", 'a","b', "batch")).r.startsWith("busy:"), true);
+});
+
+pgTest("RE6-007: 5k khách chờ cũ/mới/không chung tài nguyên không chặn khách mới", async () => {
+  await seedWaiters(5000, { kind: "stale", provider: "p1", lane: "batch", prefix: "s" });
+  await seedWaiters(5000, { kind: "fresh", provider: "p1", lane: "batch", prefix: "f" });
+  await seedWaiters(5000, { kind: "eligible", provider: "p9", lane: "modal", prefix: "o" });
+  const r = await admit("new", "p1", "m1", "batch");
+  assert.equal(r.ok, true, r.r);
+});
+
+pgTest("RE6-007: 1k khách chờ đủ điều kiện, chung lane, được nhường theo thứ tự đến; vị trí đúng", async () => {
+  await limits({ batch: 10, perProvider: 100, perModel: 100 });
+  await seedWaiters(1000, { provider: "p2", lane: "batch" });
+  const r = await admit("new", "p1", "m1", "batch");
+  assert.equal(r.ok, false);
+  assert.equal(r.r, "busy:11", "10 suất trống nhường 10 người đầu, khách mới đứng thứ 11");
+  // Khách chờ thứ nhất đến lượt thì nhận được.
+  assert.equal((await admit("w1", "p2", "m2", "batch")).ok, true);
+});
+
+pgTest("RE6-007: khách chờ không nhận được suất trên tài nguyên của chính họ thì không giữ chỗ", async () => {
+  await limits({ batch: 10, perProvider: 100, perModel: 2 });
+  await running("p2", "m2", "batch", 2);
+  await seedWaiters(1000, { provider: "p2", model: "m2", lane: "batch" });
+  assert.equal((await admit("new", "p1", "m1", "batch")).ok, true);
+});
+
+pgTest("RE6-007: phần dành cho live: batch không lấy, khách chờ batch không giữ phần dành riêng", async () => {
+  await limits({ perProvider: 10, liveReserve: 4, perModel: 50, perUser: 50 });
+  let ok = 0;
+  for (let i = 0; i < 12; i++) ok += (await admit(`b${i}`, "ali", "asr", "batch")).ok;
+  assert.equal(ok, 6);
+  await seedWaiters(1000, { provider: "ali", model: "asr", lane: "batch", prefix: "bw" });
+  let live = 0;
+  for (let i = 0; i < 6; i++) live += (await admit(`l${i}`, "ali", "lt", "live")).ok;
+  assert.equal(live, 4);
+});
+
+function counts(rows) {
+  const by = (f) => rows.reduce((m, r) => m.set(f(r), (m.get(f(r)) ?? 0) + 1), new Map());
+  return { lane: by((r) => r.lane), prov: by((r) => r.provider), model: by((r) => `${r.provider}|${r.model}`), user: by((r) => `${r.user_id}|${r.lane}`), nonlive: by((r) => (r.lane === "live" ? "-" : r.provider)) };
+}
+
+pgTest("RE6-007: burst 300 đồng thời, trộn lane/nhà/model, không vượt trần nào", async () => {
+  const L = { batch: 20, modal: 6, live: 30, perUser: 2, perUserModal: 3, perProvider: 25, perModel: 12, liveReserve: 5 };
+  await limits(L);
+  await seedWaiters(1000, { provider: "ali", lane: "batch", prefix: "bw" });
+  const lanes = ["batch", "modal", "live"]; const provs = ["ali", "groq", "modal"];
+  const t0 = performance.now();
+  const res = await Promise.all(Array.from({ length: 300 }, (_, i) => admit(`u${i % 120}`, provs[i % 3], `m${i % 4}`, lanes[(i >> 1) % 3])));
+  const wall = performance.now() - t0;
+  const rows = (await q("select user_id, provider, model, lane from work_admissions where status = 'running'")).rows;
+  assert.equal(rows.length, res.filter((r) => r.ok).length);
+  const c = counts(rows);
+  for (const [k, n] of c.lane) assert.ok(n <= L[k], `lane ${k}=${n}`);
+  for (const [k, n] of c.prov) assert.ok(n <= L.perProvider, `nhà ${k}=${n}`);
+  for (const [k, n] of c.model) assert.ok(n <= L.perModel, `model ${k}=${n}`);
+  for (const [k, n] of c.user) assert.ok(n <= (k.endsWith("|modal") ? L.perUserModal : L.perUser), `khách ${k}=${n}`);
+  for (const [k, n] of c.nonlive) if (k !== "-") assert.ok(n <= L.perProvider - L.liveReserve, `không-live ${k}=${n}`);
+  bench.burst300 = { admitted: rows.length, wall_ms: +wall.toFixed(1), latency_ms: dist(res.map((r) => r.ms)), waiters: 1000 };
+});
+
+pgTest("RE6-007: đo độ trễ theo số khách chờ (0/1k/5k) và đồng thời 25/50/100/200", { timeout: 600_000 }, async () => {
+  bench.env = (await q("select version() v")).rows[0].v;
+  bench.byWaiters = {};
+  for (const w of [0, 1000, 5000]) {
+    await q("delete from work_waiters"); await q("delete from work_admissions");
+    await limits({ perModel: 0 > 1 ? 1 : 24 });
+    // Khách chờ chung lane batch, nhà p2 đã đầy model → duyệt hết vòng lặp mà không ai giữ chỗ (trường hợp xấu nhất).
+    await running("p2", "m2", "batch", 24);
+    if (w) await seedWaiters(w, { provider: "p2", model: "m2", lane: "batch" });
+    const xs = [];
+    for (let i = 0; i < 60; i++) {
+      const r = await admit(`n${i}`, "p1", "m1", "batch");
+      assert.equal(r.ok, true);
+      await q("delete from work_admissions where user_id = $1", [`n${i}`]);
+      if (i >= 10) xs.push(r.ms);
+    }
+    bench.byWaiters[w] = dist(xs);
+  }
+  bench.burst300ByWaiters = {};
+  // Mở sẵn 300 kết nối để burst chỉ đo tyzo_admit, không đo bắt tay kết nối.
+  const warm = await Promise.all(Array.from({ length: 300 }, () => pool.connect())); warm.forEach((c) => c.release());
+  for (const w of [0, 1000, 5000]) {
+    await q("delete from work_waiters"); await q("delete from work_admissions");
+    await running("p2", "m2", "batch", 24);
+    if (w) await seedWaiters(w, { provider: "p2", model: "m2", lane: "batch" });
+    const t0 = performance.now();
+    const res = await Promise.all(Array.from({ length: 300 }, (_, i) => admit(`b${w}_${i}`, `p${i % 3}`, `m${i % 5}`, i % 4 === 0 ? "live" : "batch")));
+    bench.burst300ByWaiters[w] = { admitted: res.filter((r) => r.ok).length, wall_ms: +(performance.now() - t0).toFixed(0), latency_ms: dist(res.map((r) => r.ms)) };
+  }
+  bench.concurrency = {};
+  await q("delete from work_waiters"); await q("delete from work_admissions");
+  await seedWaiters(1000, { provider: "p2", model: "m2", lane: "batch" });
+  await running("p2", "m2", "batch", 24);
+  for (const c of [25, 50, 100, 200]) {
+    const xs = []; let ok = 0; const each = 10;
+    const t0 = performance.now();
+    await Promise.all(Array.from({ length: c }, async (_, k) => {
+      const cl = await pool.connect();
+      try {
+        for (let i = 0; i < each; i++) {
+          const u = `c${c}_${k}_${i}`;
+          const r = await admit(u, `p${k % 3}`, `m${k % 5}`, k % 4 === 0 ? "live" : "batch", cl);
+          xs.push(r.ms); ok += r.ok;
+          if (r.ok) await cl.query("delete from work_admissions where user_id = $1", [u]);
+        }
+      } finally { cl.release(); }
+    }));
+    const wall = performance.now() - t0;
+    bench.concurrency[c] = { calls: c * each, admitted: ok, wall_ms: +wall.toFixed(0), calls_per_s: +((c * each) / (wall / 1000)).toFixed(0), latency_ms: dist(xs), waiters: 1000 };
+  }
+});
diff --git a/scripts/vercel-fake-harness.mjs b/scripts/vercel-fake-harness.mjs
new file mode 100644
index 0000000..efa0e5c
--- /dev/null
+++ b/scripts/vercel-fake-harness.mjs
@@ -0,0 +1,133 @@
+/**
+ * Giả lập Vercel cho RE5-004 / RE6-003: «npx vercel» giả (CLI) + máy chủ HTTP giả (REST API, tên miền production).
+ * Chạy đúng chay_vercel_sh / buoc_vercel / id_vercel / ghi_chuyen / chuyen_dang_do trong deploy/vps/tyzo.sh.
+ * Lỗi được chèn qua danh sách FAKE_FAULT. Không gọi Vercel thật, không dùng thông tin xác thực thật.
+ */
+import { chmodSync, existsSync, mkdirSync, mkdtempSync, readFileSync, readdirSync, writeFileSync } from "node:fs";
+import { createServer } from "node:http";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { execFile } from "node:child_process";
+
+const root = new URL("..", import.meta.url).pathname;
+export const text = readFileSync(join(root, "deploy/vps/tyzo.sh"), "utf8");
+export const lib = text.slice(0, text.lastIndexOf('main "$@"; exit $?'));
+export const cliVersion = /VERCEL_CLI_VERSION="([^"]+)"/.exec(text)[1];
+export const SECRETS = ["postgres://neon/new", "new-secret", "tok-secret-123"];
+export const SHA = "a".repeat(40);
+
+const fakeNpx = `#!/usr/bin/env bash
+F="$FAKE_DIR"; echo "$*" >> "$F/calls.log"
+fault() { [[ ",\${FAKE_FAULT:-}," == *",$1,"* ]]; }
+args=("$@"); i=0; while [[ "\${args[$i]}" != vercel@* ]]; do i=$((i+1)); done
+[ "\${args[$i]}" = "vercel@$EXPECT_VERSION" ] || { echo "sai phiên bản \${args[$i]}" >&2; exit 9; }
+rest=("\${args[@]:$((i+1))}")
+sub=""; for a in "\${rest[@]}"; do case "$a" in link|env|deploy|inspect|domains) sub="$a"; break ;; esac; done
+case "$sub" in
+  link) fault link-noid || { mkdir -p .vercel; echo '{"projectId":"prj_1","orgId":"team_1"}' > .vercel/project.json; }; exit 0 ;;
+  env)
+    act=""; k=""; force=0; take=0
+    for a in "\${rest[@]}"; do
+      if [ "$take" = 1 ]; then k="$a"; take=0; continue; fi
+      case "$a" in add|rm) act="$a"; take=1 ;; --force) force=1 ;; esac
+    done
+    if [ "$act" = rm ]; then rm -f "$F/env/$k"; exit 0; fi
+    val="$(cat)"
+    if fault "add-hang-$k"; then sleep 30; fi
+    if fault "add-fail-$k"; then exit 1; fi
+    if fault "env-drop-$k"; then exit 0; fi
+    if [ -f "$F/env/$k" ] && [ "$force" != 1 ]; then echo "exists" >&2; exit 1; fi
+    printf '%s' "$val" > "$F/env/$k"; exit 0 ;;
+  deploy)
+    run=""; sha=""; nx=0
+    for a in "\${rest[@]}"; do
+      if [ "$nx" = 1 ]; then case "$a" in tyzo_run=*) run="\${a#tyzo_run=}" ;; tyzo_sha=*) sha="\${a#tyzo_sha=}" ;; esac; nx=0; continue; fi
+      [ "$a" = --meta ] && nx=1
+    done
+    cp -r "$F/env" "$F/deployed-env"
+    printf '{"id":"dpl_1","url":"tyzo-abc.vercel.app","run":"%s","sha":"%s"}' "$run" "$sha" > "$F/deploy.json"
+    if fault deploy-lost; then exit 1; fi
+    if fault deploy-hang; then sleep 30; fi
+    echo "Building..."; echo "https://tyzo-abc.vercel.app"; exit 0 ;;
+  inspect) echo "status ● Not Ready"; exit 0 ;;
+  domains) exit 0 ;;
+esac
+exit 2
+`;
+
+function startApi(work, faults) {
+  const has = (f) => faults.includes(f);
+  let polls = 0;
+  const server = createServer((req, res) => {
+    const u = new URL(req.url, "http://x");
+    const send = (code, body) => { res.writeHead(code, { "content-type": "application/json" }); res.end(JSON.stringify(body)); };
+    const site = /^\/site\/([^/]+)\/$/.exec(u.pathname);
+    if (site) { res.writeHead(has("site-down") ? 503 : 200); return res.end("ok"); }
+    if (has("api-down") || (has("api-down-after-deploy") && existsSync(join(work, "deploy.json")))) return send(500, { error: "down" });
+    if (req.headers.authorization !== "Bearer tok-secret-123" || u.searchParams.get("teamId") !== "team_1") return send(403, { error: "forbidden" });
+    const dep = existsSync(join(work, "deploy.json")) ? JSON.parse(readFileSync(join(work, "deploy.json"), "utf8")) : null;
+    const view = () => {
+      polls++;
+      const state = has("not-ready") ? "BUILDING" : has("error") ? "ERROR" : polls < 2 ? "BUILDING" : "READY";
+      return {
+        id: dep.id, url: has("wrong-url") ? "other.vercel.app" : dep.url,
+        projectId: has("wrong-project") ? "prj_other" : "prj_1", target: has("wrong-target") ? null : "production",
+        meta: { tyzo_run: dep.run, tyzo_sha: has("wrong-sha") ? "b".repeat(40) : dep.sha },
+        readyState: state, aliasAssigned: state === "READY", alias: ["tyzo-sub.vercel.app"],
+      };
+    };
+    let m;
+    if ((m = /^\/v10\/projects\/prj_1\/env$/.exec(u.pathname))) {
+      const envs = [];
+      for (const k of readdirSync(join(work, "env"))) {
+        const v = readFileSync(join(work, "env", k), "utf8");
+        const sensitive = has(`sensitive-${k}`);
+        envs.push({ id: `env_${k}`, key: k, target: ["production"], type: sensitive ? "sensitive" : "encrypted", ...(sensitive ? {} : { value: v, decrypted: true }) });
+        if (has(`dup-${k}`)) envs.push({ id: `env_${k}_2`, key: k, target: ["production", "preview"], type: "encrypted", value: v, decrypted: true });
+      }
+      return send(200, { envs });
+    }
+    if ((m = /^\/v13\/deployments\/([^/]+)$/.exec(u.pathname))) return dep && decodeURIComponent(m[1]) === dep.url ? send(200, view()) : send(404, { error: "not_found" });
+    if (u.pathname === "/v6/deployments") return send(200, { deployments: dep ? [{ uid: dep.id, url: dep.url, readyState: has("not-ready") ? "BUILDING" : "READY", meta: { tyzo_run: dep.run } }] : [] });
+    if ((m = /^\/v4\/aliases\/([^/]+)$/.exec(u.pathname))) return send(200, { alias: m[1], deploymentId: has("alias-other") ? "dpl_old" : dep && dep.id });
+    send(404, { error: "no route" });
+  });
+  return new Promise((r) => server.listen(0, "127.0.0.1", () => r(server)));
+}
+
+export async function run(fault = "", { journal = "", env: extraEnv = {} } = {}) {
+  const faults = fault.split(",").filter(Boolean);
+  const work = mkdtempSync(join(tmpdir(), "re6-003-"));
+  mkdirSync(join(work, "bin")); mkdirSync(join(work, "env"));
+  writeFileSync(join(work, "bin", "npx"), fakeNpx); chmodSync(join(work, "bin", "npx"), 0o755);
+  for (const k of ["DATABASE_URL", "BETTER_AUTH_SECRET", "LIVE_BRIDGE_URL"]) writeFileSync(join(work, "env", k), `old-${k}`);
+  writeFileSync(join(work, "vars"), "DATABASE_URL=postgres://neon/new\nBETTER_AUTH_SECRET=new-secret\nLIVE_BRIDGE_URL=wss://x/live\n");
+  if (journal) writeFileSync(join(work, "tyzo.conf.chuyen"), journal);
+  writeFileSync(join(work, "lib.sh"), lib);
+  const server = await startApi(work, faults);
+  const port = server.address().port;
+  const script = `source "${work}/lib.sh"
+CONF="${work}/tyzo.conf"
+chay_vercel_sh > "${work}/chay.sh"
+ghi_chuyen vercel-bat-dau tyzo-sub
+cd "${work}"
+VERCEL_CLI_VERSION="$VERCEL_CLI_VERSION" ENVF="${work}/vars" TOK=tok-secret-123 PROJ=tyzo-sub SCOPE= DOM= SHA=${SHA} bash "${work}/chay.sh" > "${work}/ra.txt" 2>&1
+kq=$?
+b="$(buoc_vercel "${work}/ra.txt")"; dep="$(id_vercel "${work}/ra.txt")"
+ghi_chuyen "$([ "$kq" = 0 ] && [ "$b" = xong ] && echo xong || echo "loi-$b")" "tyzo-sub $dep ${SHA}"
+echo "kq=$kq buoc=$b dep=$dep"
+if chuyen_dang_do; then echo dang-do; else echo da-ket-thuc; fi`;
+  const t0 = Date.now();
+  const r = await new Promise((resolve) => execFile("bash", ["-c", script], {
+    encoding: "utf8", timeout: 60_000,
+    env: {
+      PATH: `${work}/bin:${process.env.PATH}`, HOME: work, TMPDIR: work, FAKE_DIR: work, FAKE_FAULT: fault, EXPECT_VERSION: cliVersion,
+      VERCEL_CLI_VERSION: cliVersion, VERCEL_API: `http://127.0.0.1:${port}`, PROBE_BASE: `http://127.0.0.1:${port}/site/`,
+      T_CLI: "2", T_DEPLOY: "2", T_READY: "2", T_POLL: "0.1", ...extraEnv,
+    },
+  }, (error, stdout, stderr) => resolve({ error, stdout, stderr })));
+  server.close();
+  const ms = Date.now() - t0;
+  const read = (f) => (existsSync(join(work, f)) ? readFileSync(join(work, f), "utf8") : "");
+  return { r, ms, work, out: read("ra.txt"), env: (k) => read(join("env", k)), calls: read("calls.log"), journal: read("tyzo.conf.chuyen") };
+}
