+    def cost_of(self, data):
+        """Chi phí từ stats; None nếu không rõ (thiếu hoặc không hợp lệ)."""
+        st = (data or {}).get("stats")
+        if not isinstance(st, dict):
+            return None
+        g, m = st.get("giay_xu_ly"), st.get("tien_model_chu_usd", 0)
+        if not finite_nonneg(g) or not finite_nonneg(m):
+            return None
+        return g / 3600 * self.gpu_rate + m
