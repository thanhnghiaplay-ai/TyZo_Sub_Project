+  [ -z "$line" ] && continue
+  k="${line%%=*}"; val="${line#*=}"
+  printf '%s' "$val" | $V env add "$k" --environment production --force >/dev/null 2>&1 && echo "  đã đặt $k" || { echo "  LOI khi đặt $k"; exit 1; }
